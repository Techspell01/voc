# Copy to .env.local (git-ignored) and fill in at least one key.
# On Vercel, add the same names under Project -> Settings -> Environment Variables.

# Backup for both speech and reading, used when Gemini and Groq are down or over quota.
# Built for Indian code-mixed speech. New accounts get ₹100 of credit: https://dashboard.sarvam.ai
SARVAM_API_KEY=
# Free key at https://aistudio.google.com/apikey : transcribes and reads notes (the default AI reader)
GEMINI_API_KEY=
# Free key at https://console.groq.com : backup AI reader (its Whisper writes Malayalam in the wrong script)
GROQ_API_KEY=

# Optional
# APP_KEY=some-code            # the app then asks for this code, so strangers can't use your free quota
# STT_PROVIDERS=gemini,sarvam        # order to try speech-to-text services
# LLM_PROVIDERS=gemini,groq,sarvam   # order to try AI readers
# LLM_HINTS=off                # don't pass the lexicon's findings to the AI (for the ablation)
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_STT_MODEL=gemini-3.5-flash
# GEMINI_STT_FALLBACK=gemini-3.1-flash-lite
# GROQ_MODEL=openai/gpt-oss-120b
# SARVAM_MODEL=saaras:v3
# SARVAM_LLM_MODEL=sarvam-105b
# LLM_HEDGE_MS=5000                  # a reader slower than this gets the next one started alongside
# STT_HEDGE_MS=15000
