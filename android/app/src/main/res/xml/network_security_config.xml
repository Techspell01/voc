<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Release traffic is TLS only, and only certificates from the system store are
         trusted, so a user-installed proxy certificate cannot read the audio. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
