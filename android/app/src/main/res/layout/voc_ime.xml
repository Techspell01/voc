<?xml version="1.0" encoding="utf-8"?>
<!--
  The Voc keyboard is one floating bar, not a keyboard: a coral mic that records,
  a wave that moves with the voice, and a way back to the usual keyboard. The window
  behind it is transparent, so it reads as a bubble over the chat.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="78dp"
        android:layout_marginStart="14dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/voc_pill"
        android:elevation="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="9dp"
        android:paddingEnd="5dp">

        <FrameLayout
            android:layout_width="60dp"
            android:layout_height="60dp">

            <com.techspell.voc.ime.VocMicView
                android:id="@+id/orb"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <ImageButton
                android:id="@+id/mic"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/ime_tap" />
        </FrameLayout>

        <com.techspell.voc.ime.VocWave
            android:id="@+id/wave"
            android:layout_width="52dp"
            android:layout_height="26dp"
            android:layout_marginStart="10dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:singleLine="true"
                android:text="@string/ime_tap"
                android:textColor="#FFFFFF"
                android:textSize="15.5sp" />

            <TextView
                android:id="@+id/hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="@string/ime_hint"
                android:textColor="#99FFFFFF"
                android:textSize="11.5sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/switch_kb"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/ime_switch"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_keyboard"
            android:tint="#B3FFFFFF" />
    </LinearLayout>
</FrameLayout>
